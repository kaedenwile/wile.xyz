{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "sync": "yarn node --import=tsx --env-file=.env bin/loadNotionData.ts",
    "deploy": "yarn node --import=tsx bin/deploy.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.45",
    "@wile/battleground": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1152.0",
    "@aws-sdk/client-cloudfront": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@eslint/js": "^10.0.1",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@wile/notion-loader": "workspace:*",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
